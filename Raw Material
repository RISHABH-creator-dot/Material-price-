    <script>
        // Mermaid initialization
        mermaid.initialize({ startOnLoad: true, theme: 'dark' });

        // Demo functionality
        const uploadArea = document.getElementById('uploadArea');
        const imageUpload = document.getElementById('imageUpload');
        const processing = document.getElementById('processing');
        const resultsArea = document.getElementById('resultsArea');

        uploadArea.addEventListener('click', () => imageUpload.click());
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('border-blue-400', 'bg-blue-50');
        });
        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('border-blue-400', 'bg-blue-50');
        });
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('border-blue-400', 'bg-blue-50');
            imageUpload.files = e.dataTransfer.files;
            simulateProcessing();
        });

        imageUpload.addEventListener('change', simulateProcessing);

        function simulateProcessing() {
            uploadArea.style.display = 'none';
            processing.classList.remove('hidden');
            
            setTimeout(() => {
                processing.classList.add('hidden');
                resultsArea.classList.remove('hidden');
                initPriceChart();
            }, 3000);
        }

        function initPriceChart() {
            const ctx = document.getElementById('priceChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan 1', 'Jan 3', 'Jan 5', 'Jan 7', 'Jan 9'],
                    datasets: [{
                        label: 'HMS Scrap Price',
                        data: [320, 325, 335, 342, 340],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            ticks: { color: '#6b7280' },
                            grid: { color: '#f3f4f6' }
                        },
                        x: {
                            ticks: { color: '#6b7280' },
                            grid: { color: '#f3f4f6' }
                        }
                    }
                }
            });
        }

        // Smooth scrolling for navigation
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Navbar scroll effect
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 100) {
                nav.style.background = 'rgba(30, 58, 138, 0.95)';
                nav.style.backdropFilter = 'blur(20px)';
            } else {
                nav.style.background = 'linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #1e40af 100%)';
                nav.style.backdropFilter = 'none';
            }
        });
    </script>
